#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'Usage: ./scripts/upload-site [--dry-run] DIRECTORY SSH_HOST_OR_ALIAS' >&2
}

dry_run=false
if [ "${1:-}" = '--dry-run' ]; then
    dry_run=true
    shift
fi
if [ "$#" -ne 2 ]; then
    usage
    exit 1
fi
publish_dir=$1
target=$2
case "$target" in
    -*|*[!a-zA-Z0-9._@-]*|'')
        printf '%s\n' 'Use an SSH hostname or alias, optionally prefixed with username@.' >&2
        exit 1
        ;;
esac

for required in index.html 404.html sitemap.xml robots.txt; do
    if [ ! -s "$publish_dir/$required" ]; then
        printf 'Missing generated file: %s/%s\n' "$publish_dir" "$required" >&2
        exit 1
    fi
done
command -v scp >/dev/null 2>&1 || {
    printf '%s\n' 'scp is required to publish.' >&2
    exit 1
}

# Shellter allows 50 MB of published files. Leave room for filesystem overhead.
size_kb=$(du -sk "$publish_dir" | awk '{print $1}')
if [ "$size_kb" -gt 48000 ]; then
    printf '%s\n' 'The built site is too close to the 50 MB webspace limit.' >&2
    exit 1
fi

# CI supplies its own SSH config; local publishing uses ~/.ssh/config.
set --
if [ -n "${WEBSPACE_SSH_CONFIG:-}" ]; then
    set -- -F "$WEBSPACE_SSH_CONFIG"
fi

# Check the existing webspace without creating or replacing its managed link.
ssh "$@" "$target" 'test -d "$HOME/public_html" && test -w "$HOME/public_html"' || {
    printf '%s\n' 'Could not access writable ~/public_html/. Check SSH and enable the webspace with webspace on.' >&2
    exit 1
}

if [ "$dry_run" = true ]; then
    printf '\nWould copy these files into %s:public_html/ using scp:\n' "$target"
    find "$publish_dir" -type f -print
    printf '\n%s\n' 'Dry run: no remote files were changed. Existing remote files will not be deleted.'
    exit 0
fi
# Copy the directory contents into the provider-managed link.
# scp copies all generated files and leaves obsolete remote files in place.
scp "$@" -r "$publish_dir/." "$target:public_html/"
