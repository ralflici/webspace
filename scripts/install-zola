#!/bin/sh
set -eu

# Update the version and its release checksum together.
version='0.23.6'
checksum='8f5132b3522412d04e395e0b25f6d68613ad272a873e54a2b3ebf664873024a4'

if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
    printf '%s\n' 'This installer supports Linux x86_64. Install Zola manually on other platforms.' >&2
    exit 1
fi

site_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$site_root"
mkdir -p .tools .cache
archive=".cache/zola-v$version.tar.gz"
curl --fail --location --silent --show-error --retry 3 \
    "https://github.com/getzola/zola/releases/download/v$version/zola-v$version-x86_64-unknown-linux-gnu.tar.gz" \
    --output "$archive"
printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check
tar -xzf "$archive" -C .tools zola
./.tools/zola --version
