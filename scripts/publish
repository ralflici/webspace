#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'Usage: ./scripts/publish [--dry-run] SSH_HOST_OR_ALIAS' >&2
    printf '%s\n' 'Builds the site and syncs it to public_html/ on your Shellter account.' >&2
}

dry_run=false
if [ "${1:-}" = '--dry-run' ]; then
    dry_run=true
    shift
fi
if [ "$#" -ne 1 ]; then
    usage
    exit 1
fi
target=$1
case "$target" in
    -*|*[!a-zA-Z0-9._@-]*|'')
        printf '%s\n' 'Use an SSH hostname or alias, optionally prefixed with username@.' >&2
        exit 1
        ;;
esac

site_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$site_root"
command -v rsync >/dev/null 2>&1 || {
    printf '%s\n' 'rsync is required to publish.' >&2
    exit 1
}
./scripts/zola build

# Shellter allows 50 MB of published files. Leave room for filesystem overhead.
size_kb=$(du -sk public | awk '{print $1}')
if [ "$size_kb" -gt 48000 ]; then
    printf '%s\n' 'The built site is too close to the 50 MB webspace limit.' >&2
    exit 1
fi

set -- -av --delete-delay -e ssh
if [ "$dry_run" = true ]; then
    set -- "$@" --dry-run
fi
# public_html is the provider-managed link. Copy its contents; keep the link.
# This directory is dedicated to this site. Remove obsolete generated files.
rsync "$@" public/ "$target:public_html/"
