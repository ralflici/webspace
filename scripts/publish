#!/bin/sh
set -eu

usage() {
    printf '%s\n' 'Usage: ./scripts/publish [--dry-run] SSH_HOST_OR_ALIAS' >&2
    printf '%s\n' 'Builds the site and copies it to public_html/ on your Shellter account.' >&2
}

dry_run=false
if [ "${1:-}" = '--dry-run' ]; then
    dry_run=true
    shift
fi
if [ "$#" -ne 1 ]; then
    usage
    exit 1
fi
target=$1
case "$target" in
    -*|*[!a-zA-Z0-9._@-]*|'')
        printf '%s\n' 'Use an SSH hostname or alias, optionally prefixed with username@.' >&2
        exit 1
        ;;
esac

site_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$site_root"
# Keep the production build separate from the running local preview.
publish_dir='.cache/publish'
./scripts/zola build --output-dir "$publish_dir" --force

set --
if [ "$dry_run" = true ]; then
    set -- --dry-run
fi
exec ./scripts/upload-site "$@" "$publish_dir" "$target"
